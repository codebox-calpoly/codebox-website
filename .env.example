# Server-only credentials for the /interest and /bootcamp forms.
# Copy this file to .env.local and fill in the values from your Supabase
# project. None of these are exposed to the browser — do not add a
# NEXT_PUBLIC_ prefix.

# Postgres connection string used by Drizzle (lib/db) to read and write
# tables. Dashboard > Connect > ORMs (or Connection string). On Vercel, use
# the transaction pooler URL (port 6543).
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Supabase API credentials, used only for resume uploads to Storage.
# Dashboard > Project Settings > API.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
