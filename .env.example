# Supabase credentials for the /interest form.
# Copy this file to .env.local and fill in the values from your Supabase
# project: Dashboard > Project Settings > API.
#
# Both are server-only — they are read exclusively by app/api/interest/route.ts
# and are never exposed to the browser. Do not add a NEXT_PUBLIC_ prefix.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
